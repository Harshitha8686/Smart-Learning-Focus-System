{
  "manifest_version": 3,
  "name": "Smart Learning Focus System",
  "version": "1.0",

  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },
"content_scripts": [
  {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ],
    "js": [
      "content.js"
    ]
  }
],

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}